# apprepo environment file. Copy to /etc/apprepo/apprepo.env and adjust.
# Flags passed on the command line take precedence over these variables.

# Listen address
APPREPO_ADDR=:8080

# Root directory for stored binaries (must be writable by the service user)
APPREPO_DATA_DIR=/opt/apps

# SQLite database path (default: {APPREPO_DATA_DIR}/apprepo.db).
# Вынесли БД за пределы APPREPO_DATA_DIR — добавьте её каталог в ReadWritePaths=
# юнита, иначе под ProtectSystem=strict он останется read-only и сервис упадёт
# с "open database ...: unable to open database file".
#APPREPO_DB=/opt/apps/apprepo.db

# External base URL used to build download links in the API
APPREPO_BASE_URL=http://localhost:8080

# Max upload size in bytes (default 2 GiB)
#APPREPO_MAX_UPLOAD=2147483648
